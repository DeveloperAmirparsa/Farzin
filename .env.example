# TGJU public site feed. Leave blank to use built-in mirrors.
TGJU_FEED_URL=
PORT=3000
HOST=0.0.0.0
# Login protects every application page and API. Password must be at least 10 characters; 12+ is recommended.
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password
# Optional persistent signing key; in-memory sessions still end on server restart.
SESSION_SECRET=replace-with-a-long-random-secret
# Persistent data path. On Render/Railway mount a persistent volume here.
FARZIN_DATA_DIR=./data
